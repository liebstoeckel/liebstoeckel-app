{
  "name": "@liebstoeckel/cli",
  "version": "0.3.12",
  "description": "The liebstoeckel CLI to scaffold, develop, build, and present code-first decks.",
  "keywords": [
    "liebstoeckel",
    "slides",
    "presentation-slides",
    "ai-agents",
    "ai",
    "skills",
    "cli",
    "mdx",
    "react"
  ],
  "homepage": "https://liebstoeckel.app",
  "bugs": "https://github.com/liebstoeckel/liebstoeckel-app/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liebstoeckel/liebstoeckel-app.git",
    "directory": "packages/cli"
  },
  "license": "MPL-2.0",
  "author": "Leon Kaucher <contact@liebstoeckel.app>",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "!bin/**/*.test.ts",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "skill",
    "!**/.impeccable",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18",
    "bun": ">=1.3"
  },
  "type": "module",
  "bin": {
    "liebstoeckel": "./bin/liebstoeckel.js",
    "lst": "./bin/liebstoeckel.js"
  },
  "exports": {
    ".": "./src/cli.ts",
    "./new": "./src/new.ts",
    "./add": "./src/add.ts",
    "./trust": "./src/trust.ts",
    "./migrations": "./src/migrations.ts",
    "./dev-loader": "./src/dev-loader.ts",
    "./source": "./src/source.ts"
  },
  "dependencies": {
    "@liebstoeckel/build": "workspace:^",
    "@liebstoeckel/dev-server": "workspace:^",
    "@liebstoeckel/engine": "workspace:^",
    "@liebstoeckel/live-server": "workspace:^",
    "@liebstoeckel/present-relay": "workspace:^",
    "@liebstoeckel/registry": "workspace:^",
    "@liebstoeckel/theme": "workspace:^",
    "@liebstoeckel/thumbnails": "workspace:^",
    "citty": "^0.2.2"
  },
  "optionalDependencies": {
    "@oven/bun-darwin-aarch64": "1.3.14",
    "@oven/bun-darwin-x64": "1.3.14",
    "@oven/bun-linux-aarch64": "1.3.14",
    "@oven/bun-linux-x64": "1.3.14",
    "@oven/bun-windows-aarch64": "1.3.14",
    "@oven/bun-windows-x64": "1.3.14"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
