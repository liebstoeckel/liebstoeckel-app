{
  "name": "@liebstoeckel/build",
  "version": "0.4.1",
  "description": "The liebstoeckel build core: bundles a deck into one self-contained HTML file and serves it with hot reload, on esbuild.",
  "keywords": [
    "liebstoeckel",
    "slides",
    "presentation-slides",
    "esbuild",
    "mdx",
    "tailwindcss",
    "hot-reload",
    "bundler"
  ],
  "homepage": "https://liebstoeckel.app",
  "bugs": "https://github.com/liebstoeckel/liebstoeckel-app/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liebstoeckel/liebstoeckel-app.git",
    "directory": "packages/build"
  },
  "license": "MPL-2.0",
  "author": "Leon Kaucher <contact@liebstoeckel.app>",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./dev": "./src/dev/index.ts",
    "./core": "./src/core/index.ts",
    "./check": "./src/check.ts"
  },
  "dependencies": {
    "@liebstoeckel/engine": "workspace:^",
    "@liebstoeckel/plugin-sdk": "workspace:^",
    "@mdx-js/mdx": "^3.1.1",
    "@shikijs/rehype": "^3.23.0",
    "esbuild": "0.28.2",
    "react-refresh": "^0.18.0",
    "shiki": "^3.23.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "esbuild-wasm": "0.28.2"
  }
}
