{
  "name": "release-fixture",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The release QA fixture deck: every authoring feature a release has to keep working. Installed from a registry by prepare.ts, never as a workspace.",
  "files": [
    "index.html",
    "main.tsx",
    "slides",
    "components",
    "charts",
    "brands",
    "plugins",
    "assets"
  ],
  "scripts": {
    "dev": "liebstoeckel dev",
    "build": "liebstoeckel build"
  },
  "dependencies": {
    "@liebstoeckel/components": "RELEASE",
    "@liebstoeckel/engine": "RELEASE",
    "@liebstoeckel/plugin-poll": "RELEASE",
    "@liebstoeckel/plugin-qa": "RELEASE",
    "@liebstoeckel/plugin-reactions": "RELEASE",
    "@liebstoeckel/plugin-sdk": "RELEASE",
    "@liebstoeckel/plugin-ui": "RELEASE",
    "@liebstoeckel/theme": "RELEASE",
    "@visx/axis": "^4.0.0",
    "@visx/curve": "^4.0.0",
    "@visx/grid": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "motion": "^12.40.0",
    "ms": "2.1.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@liebstoeckel/cli": "RELEASE"
  },
  "liebstoeckel": {
    "plugins": {
      "applause": {
        "audienceWrites": [
          "claps"
        ]
      }
    }
  }
}
