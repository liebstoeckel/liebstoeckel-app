{
  "name": "@liebstoeckel/dev-server",
  "version": "0.3.1",
  "description": "Local dev mode for liebstoeckel decks: HMR serving plus a shell page with an annotation sidebar beside the framed deck, and an agent poll loop.",
  "keywords": [
    "liebstoeckel",
    "slides",
    "presentation-slides",
    "ai-agents",
    "ai",
    "skills",
    "hmr",
    "annotations",
    "bun"
  ],
  "homepage": "https://liebstoeckel.app",
  "bugs": "https://github.com/liebstoeckel/liebstoeckel-app/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liebstoeckel/liebstoeckel-app.git",
    "directory": "packages/dev-server"
  },
  "license": "MPL-2.0",
  "author": "Leon Kaucher <contact@liebstoeckel.app>",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "drawer",
    "ui",
    "!stories",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!ui/fixtures.ts",
    "!**/.impeccable",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./protocol": "./src/protocol.ts",
    "./bridge": "./src/bridge.ts",
    "./ui": "./src/ui.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/schibsted-grotesk": "^5.2.8",
    "citty": "^0.2.2",
    "modern-screenshot": "^4.6.5"
  },
  "scripts": {
    "stories": "bun run stories/serve.ts"
  },
  "peerDependencies": {
    "@liebstoeckel/cli": "workspace:^",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
