# dependencies
node_modules/

# build output (single-file decks are generated)
dist/
# TanStack Start / Nitro build output — rebuilt in-image by the Dockerfile
.output/
.nitro/
.tanstack/

# astro docs cache
.astro/

# dev-mode working state (annotations, screenshots, revert snapshots, session token)
.liebstoeckel/

# logs / scratch
*.log
_shot.png
_ft/

# test temp dirs created IN the source tree (need repo node_modules for bundling);
# leak only if a test is killed/timed-out before its cleanup runs — never commit them
.vt-*/
.verify-*/
srvplugin-*/

# kustomize --enable-helm chart cache (pulled next to the kustomization on local builds)
deploy/**/charts/

# editor / OS
.DS_Store
.idea/
*.swp
.npmrc

# stray verification screenshots (root, hidden)
/.*.png

# cra-cli lookup cache (the .cra/ store itself IS committed: SBOMs, scans, lifetimes)
.cra/cache/

# local scratch notes, never committed
docs/private/

# machine-local office defaults (OFFICE_LITERT_LM_COMMAND and the like)
packages/office/.env
